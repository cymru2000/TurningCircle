{# ---------------------------------------------------------------------------
   Shared building blocks. Every front-page block, the topic pages and the
   archive render stories through these macros, so the card look is defined
   once. Photos are optional: an article with no `hero` in its frontmatter
   simply renders without a picture.
   --------------------------------------------------------------------------- #}

{% macro photo(base, sizes, w, h, eager) %}
<picture>
    <source type="image/webp" srcset="{{ base }}-400.webp 400w, {{ base }}-800.webp 800w, {{ base }}-1600.webp 1600w" sizes="{{ sizes }}">
    <img src="{{ base }}-800.jpg" srcset="{{ base }}-400.jpg 400w, {{ base }}-800.jpg 800w, {{ base }}-1600.jpg 1600w" sizes="{{ sizes }}" width="{{ w }}" height="{{ h }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %} alt="">
</picture>
{% endmacro %}

{% macro meta(post, showTopic) %}
<p class="meta">{% if showTopic %}<span class="tag">{{ post.data.topic }}</span>{% endif %}<span>{{ post.date | dateHuman }}</span><span>{{ post.templateContent | readingTime }} min read</span></p>
{% endmacro %}

{# the lead story: biggest picture, biggest headline #}
{% macro leader(post) %}
<article class="lead">
    {% if post.data.hero %}<figure class="thumb"><a href="{{ post.url }}" tabindex="-1">{{ photo(post.data.hero, "(max-width:960px) 100vw, 700px", 1600, 900, true) }}</a></figure>{% endif %}
    <p class="kicker">{{ post.data.topic }}</p>
    <h1><a href="{{ post.url }}">{{ post.data.title }}</a></h1>
    {% if post.data.description %}<p class="stand">{{ post.data.description }}</p>{% endif %}
    <p class="meta"><span>By {{ post.data.author }}</span><span>{{ post.date | dateHuman }}</span><span>{{ post.templateContent | readingTime }} min read</span></p>
</article>
{% endmacro %}

{# a picture card: second tier, briefs, topic grids #}
{% macro card(post, sizes, w, h, level) %}
<article>
    {% if post.data.hero %}<figure class="thumb"><a href="{{ post.url }}" tabindex="-1">{{ photo(post.data.hero, sizes, w, h, false) }}</a></figure>{% endif %}
    <p class="kicker">{{ post.data.topic }}</p>
    {% if level == 2 %}<h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>{% else %}<h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>{% endif %}
    {% if post.data.description %}<p class="line-clamp">{{ post.data.description }}</p>{% endif %}
    {{ meta(post, false) }}
</article>
{% endmacro %}

{# a row in the chronological river, used on page 2 onwards #}
{% macro river(post) %}
<li>
    {% if post.data.hero %}<figure class="thumb"><a href="{{ post.url }}" tabindex="-1">{{ photo(post.data.hero, "150px", 400, 225, false) }}</a></figure>{% endif %}
    <div>
        <p class="kicker">{{ post.data.topic }}</p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.description %}<p class="line-clamp">{{ post.data.description }}</p>{% endif %}
        {{ meta(post, false) }}
    </div>
</li>
{% endmacro %}

{% macro pager() %}
{% if pagination.hrefs.length > 1 %}
<nav class="pager" aria-label="Pages">
    {% for href in pagination.hrefs %}<a href="{{ href }}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>{% endfor %}
    {% if pagination.pageNumber + 1 < pagination.hrefs.length %}<a class="next" href="{{ pagination.hrefs[pagination.pageNumber + 1] }}">Next</a>{% endif %}
</nav>
{% endif %}
{% endmacro %}
