---
layout: base.njk
---
<div class="hero">
    <p class="kicker">Independent UK car coverage</p>
    <h1>The car market, read properly.</h1>
    <p class="standfirst">TurningCircle covers the UK car market and the switch to electric, with the data behind every claim. All figures link to their sources, and nothing here is sponsored.</p>
</div>
<section aria-label="Latest articles">
    <p class="list-head">Latest articles</p>
    <ul class="article-list">
        {% for post in collections.posts %}
        <li>
            <div class="entry-meta">
                <span class="tag">{{ post.data.tags[0] | tagLabel }}</span>
                <span>{{ post.date | dateHuman }}</span>
                <span>{{ post.templateContent | readingTime }} min read</span>
            </div>
            <h2 class="entry-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            {% if post.data.description %}<p class="entry-desc">{{ post.data.description }}</p>{% endif %}
        </li>
        {% endfor %}
    </ul>
</section>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "TurningCircle",
    "url": "{{ site.url }}/",
    "description": {{ (description or site.description) | dump | safe }},
    "inLanguage": "en-GB",
    "publisher": {
        "@type": "Organization",
        "name": "TurningCircle",
        "url": "{{ site.url }}/"
    }
}
</script>
