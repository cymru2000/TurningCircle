---
layout: base.njk
---
{% from "card.njk" import photo %}
<article>
    {% if hero %}
    <figure class="article-hero">
        <div class="thumb">{{ photo(hero, "(max-width:1180px) 100vw, 1140px", 1600, 900, true) }}</div>
        {% if heroCredit %}<p class="credit">Photograph: {{ heroCredit }}</p>{% endif %}
    </figure>
    {% endif %}
    <header class="article-header">
        <p class="kicker"><a href="/topic/{{ topic | topicSlug }}/" style="text-decoration:none">{{ topic or tags[0] | tagLabel }}</a></p>
        <h1>{{ title }}</h1>
        {% if description %}<p class="article-standfirst">{{ description }}</p>{% endif %}
        <div class="byline">
            <span class="who">By {{ author }}</span>
            <span><time datetime="{{ date | dateISO }}">{{ date | dateHuman }}</time></span>
            <span>{{ content | readingTime }} min read</span>
        </div>
    </header>
    <div class="prose">
        {{ content | safe }}
    </div>
</article>
<aside class="article-footer">
    {% set related = (collections.posts | byTopic(topic)) | notUrl(page.url) %}
    {% if related.length == 0 %}{% set related = collections.posts | notUrl(page.url) %}{% endif %}
    <p class="rule-head">More in {{ topic }}<a href="/topic/{{ topic | topicSlug }}/">All {{ topic }} &rarr;</a></p>
    <ul class="related">
        {% for p in related %}{% if loop.index <= 3 %}
        <li><a href="{{ p.url }}">{{ p.data.title }}<span class="d">{{ p.date | dateHuman }} &middot; {{ p.templateContent | readingTime }} min read</span></a></li>
        {% endif %}{% endfor %}
    </ul>
</aside>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": {{ title | dump | safe }},
    {% if description %}"description": {{ description | dump | safe }},{% endif %}
    "datePublished": "{{ date | dateISO }}",
    "dateModified": "{{ (updated or date) | dateISO }}",
    "image": ["{{ site.url }}{{ image or (hero and (hero ~ '-og.jpg')) or ('/assets/og/' ~ (page.url | replace('/', '')) ~ '.png') }}"],
    "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
    "articleSection": {{ (topic or '') | dump | safe }},
    "author": {
        "@type": "Organization",
        "name": {{ (author or 'The TurningCircle Team') | dump | safe }},
        "url": "{{ site.url }}/about/"
    },
    "publisher": {
        "@type": "Organization",
        "name": "TurningCircle",
        "url": "{{ site.url }}/",
        "logo": {
            "@type": "ImageObject",
            "url": "{{ site.url }}/assets/img/apple-touch-icon.png"
        }
    },
    "isAccessibleForFree": true,
    "inLanguage": "en-GB"
}
</script>
