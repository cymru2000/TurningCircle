<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if page.url.startsWith("/page/") %}{{ title or "TurningCircle" }}, page {{ pagination.pageNumber + 1 }}{% elif title and title != "TurningCircle" %}{{ title }} | TurningCircle{% else %}TurningCircle - The UK car market, read properly{% endif %}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta name="theme-color" content="#faf8f4">
    <link rel="alternate" type="application/rss+xml" title="TurningCircle RSS" href="{{ site.url }}/feed.xml">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
    <meta property="og:site_name" content="TurningCircle">
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:title" content="{{ title or 'TurningCircle' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    {% if ogType == 'article' %}
    {% set ogImage = image or ('/assets/og/' ~ (page.url | replace('/', '')) ~ '.png') %}
    {% else %}
    {% set ogImage = image or '/assets/og/default.png' %}
    {% endif %}
    <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% if ogType == 'article' and date %}<meta property="article:published_time" content="{{ date | dateISO }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or 'TurningCircle' }}">
    {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
    <link rel="preload" href="/assets/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/newsreader-var.woff2" as="font" type="font/woff2" crossorigin>
    <style>
        @font-face{font-family:"Fraunces";src:url("/assets/fonts/fraunces-var.woff2") format("woff2");font-weight:100 900;font-style:normal;font-display:swap}
        @font-face{font-family:"Newsreader";src:url("/assets/fonts/newsreader-var.woff2") format("woff2");font-weight:200 800;font-style:normal;font-display:swap}
        @font-face{font-family:"Newsreader";src:url("/assets/fonts/newsreader-italic-var.woff2") format("woff2");font-weight:200 800;font-style:italic;font-display:swap}
        :root{
            --paper:#faf8f4;--paper-2:#f1ede3;--ink:#23211b;--ink-soft:#6b665a;
            --rule:#ddd5c5;--amber:#d97736;--amber-deep:#a04a12;--slate:#1a1e24;
            --display:"Fraunces",Georgia,"Times New Roman",serif;
            --text:"Newsreader",Georgia,"Times New Roman",serif;
            --ui:system-ui,-apple-system,"Segoe UI",sans-serif;
        }
        *{box-sizing:border-box;margin:0;padding:0}
        html{font-optical-sizing:auto}
        body{background:var(--paper);color:var(--ink);font-family:var(--text);line-height:1.65;font-size:1.0625rem;-webkit-font-smoothing:antialiased}
        img{max-width:100%;height:auto}
        picture{display:block}
        .shell{max-width:1140px;margin-inline:auto;padding-inline:1.25rem}
        .skip{position:absolute;left:-999px;top:0;background:var(--slate);color:#fff;padding:.5rem .9rem;z-index:10;font-family:var(--ui);font-size:.8rem}
        .skip:focus{left:0}
        :focus-visible{outline:2px solid var(--amber);outline-offset:3px}
        ::selection{background:#f3d9bf}
        /* Masthead */
        .site-header{border-top:7px solid var(--amber)}
        .mast-row{display:flex;justify-content:space-between;align-items:flex-end;gap:1.5rem;flex-wrap:wrap;padding-block:1.3rem .9rem}
        .wordmark{font-family:var(--display);font-weight:640;font-size:2rem;letter-spacing:-.02em;text-decoration:none;color:var(--ink);line-height:1}
        .wordmark span{color:var(--amber)}
        .wordmark-small{font-size:1.3rem}
        .mast-note{font-family:var(--ui);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);text-align:right}
        .mast-note b{display:block;font-size:.8rem;letter-spacing:.06em;color:var(--ink)}
        .topicbar{border-block:1px solid var(--ink);background:var(--paper-2)}
        .topicbar ul{display:flex;gap:1.5rem;list-style:none;flex-wrap:wrap;padding-block:.62rem;font-family:var(--ui);font-size:.72rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
        .topicbar a{text-decoration:none;color:var(--ink)}
        .topicbar a:hover{color:var(--amber-deep)}
        .topicbar a[aria-current]{color:var(--amber-deep)}
        main.shell{padding-block:1.9rem 4rem;min-height:55vh}
        /* Shared type */
        h1,h2,h3{font-family:var(--display);font-weight:600;letter-spacing:-.01em;line-height:1.14}
        h1 a,h2 a,h3 a{text-decoration:none;color:var(--ink)}
        h1 a:hover,h2 a:hover,h3 a:hover{color:var(--amber-deep)}
        .kicker{font-family:var(--ui);font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--amber-deep)}
        .meta{display:flex;gap:.9rem;flex-wrap:wrap;font-family:var(--ui);font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
        .meta .tag{color:var(--amber-deep)}
        .rule-head{font-family:var(--ui);font-size:.72rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
            border-top:2px solid var(--ink);padding-top:.6rem;display:flex;justify-content:space-between;align-items:baseline;gap:1rem;color:var(--ink)}
        .rule-head a{color:var(--ink-soft);text-decoration:none;font-size:.66rem;font-weight:600}
        figure{margin:0}
        .thumb{overflow:hidden;background:var(--paper-2)}
        .thumb img{width:100%;transition:transform .35s ease}
        .thumb:hover img{transform:scale(1.03)}
        .credit{font-family:var(--ui);font-size:.63rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-top:.45rem}
        .line-clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
        .pager{display:flex;gap:.4rem;align-items:center;justify-content:center;margin-top:2.4rem;font-family:var(--ui);font-size:.75rem;font-weight:600}
        .pager a,.pager span{display:inline-flex;min-width:2.1rem;height:2.1rem;align-items:center;justify-content:center;text-decoration:none;border:1px solid var(--rule);color:var(--ink-soft)}
        .pager a[aria-current]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
        .pager .next{width:auto;padding-inline:.9rem;letter-spacing:.08em;text-transform:uppercase;font-size:.68rem}
        /* Front page */
        .top{display:grid;grid-template-columns:1.85fr 1fr;gap:2.4rem;align-items:start}
        .lead h1{font-size:clamp(1.95rem,3.6vw,2.7rem);margin-top:.6rem}
        .lead .stand{font-size:1.16rem;color:var(--ink-soft);font-style:italic;margin:.8rem 0 .6rem;max-width:54ch}
        .today ol{list-style:none;counter-reset:n;margin-top:.7rem}
        .today li{counter-increment:n;padding-block:.62rem;border-bottom:1px solid var(--rule);display:grid;grid-template-columns:1.5rem 1fr;gap:.5rem}
        .today li::before{content:counter(n);font-family:var(--ui);font-size:.7rem;font-weight:700;color:var(--amber);padding-top:.25rem}
        .today a{font-family:var(--display);font-weight:600;font-size:1.02rem;line-height:1.22;text-decoration:none}
        .today span{display:block;font-family:var(--ui);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-top:.2rem}
        .quad{display:grid;grid-template-columns:repeat(4,1fr);gap:1.6rem;padding-block:1.9rem;border-top:1px solid var(--rule);border-bottom:3px double var(--ink);margin-top:1.6rem}
        .quad h2{font-size:1.1rem;margin:.45rem 0}
        .briefs{display:grid;grid-template-columns:repeat(3,1fr);gap:1.8rem 2rem;margin-top:2.2rem}
        .briefs article{border-bottom:1px solid var(--rule);padding-bottom:1.1rem}
        .briefs h3{font-size:1.06rem;margin:.4rem 0}
        .briefs p{color:var(--ink-soft);font-size:.92rem;margin-bottom:.45rem}
        .four-rails{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-top:3rem}
        .four-rails ul{list-style:none;margin-top:.7rem}
        .four-rails li{padding-block:.5rem;border-bottom:1px solid var(--rule);font-family:var(--display);font-weight:600;font-size:.98rem;line-height:1.22}
        .four-rails a{text-decoration:none;color:var(--ink)}
        .four-rails a:hover{color:var(--amber-deep)}
        .four-rails .d{display:block;font-family:var(--ui);font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);margin-top:.15rem;font-weight:600}
        .river{list-style:none;margin-top:1.2rem}
        .river li{display:grid;grid-template-columns:150px 1fr;gap:1.3rem;padding-block:1.3rem;border-bottom:1px solid var(--rule)}
        .river h2{font-size:1.28rem;margin-top:.3rem}
        .river p{color:var(--ink-soft);font-size:.97rem;margin:.3rem 0 .45rem}
        /* Article */
        .article-hero{margin-bottom:2.1rem}
        .article-header,.page-head{max-width:44rem}
        .article-header h1,.page-head h1{font-family:var(--display);font-weight:600;font-size:clamp(1.9rem,4vw,2.75rem);line-height:1.09;letter-spacing:-.012em;margin-top:.65rem}
        .article-standfirst{font-style:italic;font-size:1.24rem;line-height:1.5;color:var(--ink-soft);margin-top:1.05rem}
        .byline{display:flex;gap:1.1rem;flex-wrap:wrap;font-family:var(--ui);font-size:.71rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);border-block:1px solid var(--rule);padding-block:.8rem;margin-top:1.7rem}
        .byline .who{color:var(--ink)}
        .prose{max-width:44rem;margin-top:2.6rem;overflow-wrap:break-word}
        .prose p{margin-block:1.15em;font-size:1.13rem;line-height:1.72}
        .prose>p:first-of-type::first-letter{font-family:var(--display);font-weight:600;font-size:3.4em;line-height:.8;float:left;padding:.09em .13em 0 0;color:var(--slate)}
        .prose>p:last-of-type::after{content:"\00A0\25C6";color:var(--amber);font-size:.7em}
        .prose h2{font-family:var(--display);font-weight:600;font-size:1.68rem;line-height:1.2;letter-spacing:-.008em;margin-top:2.7rem}
        .prose h3{font-family:var(--display);font-weight:600;font-size:1.3rem;margin-top:2.1rem}
        .prose a{color:var(--amber-deep);text-underline-offset:3px}
        .prose a:hover{color:var(--ink)}
        .prose ul,.prose ol{margin-block:1.2em;padding-left:1.5rem}
        .prose li{margin-block:.45em;font-size:1.08rem}
        .prose h2+ul{list-style:none;padding-left:0;margin-block:.9em}
        .prose h2+ul li{font-size:.95rem;color:var(--ink-soft)}
        .prose h2+ul li::before{content:"\2192\00A0\00A0";color:var(--amber)}
        .prose table{display:block;width:100%;max-width:100%;overflow-x:auto;border-collapse:collapse;margin-block:1.7rem;font-size:.97rem}
        .prose th{font-family:var(--ui);font-size:.71rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;text-align:left;border-bottom:2px solid var(--ink);padding:.6rem .65rem;white-space:nowrap}
        .prose td{border-bottom:1px solid var(--rule);padding:.6rem .65rem}
        .prose tbody tr:nth-child(even) td{background:var(--paper-2)}
        .prose blockquote{border-left:3px solid var(--amber);padding:.15rem 0 .15rem 1.25rem;margin-block:1.6rem;font-style:italic;color:var(--ink-soft);font-size:1.15rem}
        .prose strong{font-weight:600}
        .prose hr{border:0;border-top:1px solid var(--rule);margin-block:2.3rem}
        .article-footer{max-width:44rem;margin-top:3.2rem}
        .related{list-style:none;margin-top:.9rem}
        .related li{border-bottom:1px solid var(--rule)}
        .related a{display:inline-block;font-family:var(--display);font-weight:600;font-size:1.18rem;text-decoration:none;color:var(--ink);padding-block:.7rem}
        .related a:hover{color:var(--amber-deep)}
        .related .d{display:block;font-family:var(--ui);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-top:.15rem}
        /* Topic landing page */
        .topic-head{border-bottom:3px double var(--ink);padding-bottom:1.3rem;margin-bottom:.4rem}
        .topic-head h1{font-size:clamp(2rem,4vw,2.9rem);margin-top:.5rem}
        .topic-head p{color:var(--ink-soft);font-style:italic;font-size:1.16rem;margin-top:.7rem;max-width:56ch}
        .topic-list{margin-top:2rem}
        .topic-feature{display:grid;grid-template-columns:1.5fr 1fr;gap:2.2rem;align-items:start;padding-bottom:2rem;border-bottom:1px solid var(--rule)}
        .topic-feature h2{font-size:1.85rem;margin-top:.5rem}
        .topic-feature p{color:var(--ink-soft);margin-top:.6rem}
        .topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.9rem 2rem;margin-top:2rem}
        .topic-grid h3{font-size:1.14rem;margin:.4rem 0}
        .topic-grid p{color:var(--ink-soft);font-size:.95rem;margin-bottom:.4rem}
        /* Archive */
        .archive-month{margin-top:2.4rem}
        .archive-list{list-style:none;columns:2;column-gap:2.6rem;margin-top:.8rem}
        .archive-list li{break-inside:avoid;padding-block:.45rem;border-bottom:1px solid var(--rule);font-family:var(--display);font-weight:600;font-size:1.02rem}
        .archive-list a{text-decoration:none;color:var(--ink)}
        .archive-list .d{font-family:var(--ui);font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-left:.4rem;white-space:nowrap}
        /* Footer */
        .site-footer{border-top:2px solid var(--ink);padding-block:1.7rem 2.3rem}
        .footer-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
        .site-nav{display:flex;gap:1.2rem;flex-wrap:wrap;font-family:var(--ui);font-size:.7rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase}
        .site-nav a{text-decoration:none;color:var(--ink-soft)}
        .site-nav a:hover{color:var(--amber-deep)}
        .footer-colophon{margin-top:1.1rem;font-family:var(--ui);font-size:.72rem;letter-spacing:.05em;color:var(--ink-soft)}
        .footer-colophon p{margin-block:.15rem}
        @media (max-width:960px){
            .top{grid-template-columns:1fr}
            .quad{grid-template-columns:1fr 1fr}
            .briefs{grid-template-columns:1fr 1fr}
            .four-rails{grid-template-columns:1fr 1fr}
            .topic-feature{grid-template-columns:1fr}
            .topic-grid{grid-template-columns:1fr 1fr}
        }
        @media (max-width:620px){
            .mast-row{padding-block:.95rem .8rem}
            .topicbar ul{gap:1rem;font-size:.68rem}
            .quad{grid-template-columns:1fr}
            .briefs{grid-template-columns:1fr}
            .four-rails{grid-template-columns:1fr}
            .topic-grid{grid-template-columns:1fr}
            .archive-list{columns:1}
            .river li{grid-template-columns:112px 1fr;gap:.9rem}
            .prose p{font-size:1.07rem}
            .prose>p:first-of-type::first-letter{font-size:3em}
        }
    </style>
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="shell mast-row">
            <a class="wordmark" href="/">Turning<span>Circle</span></a>
            <div class="mast-note">
                <b>{{ today | dateHuman }}</b>{% if page.date %}updated {{ today | timeShort }}{% endif %}
            </div>
        </div>
        <nav class="topicbar" aria-label="Topics">
            <div class="shell">
                <ul>
                    <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>All</a></li>
                    {% for t in site.topics %}
                    <li><a href="/topic/{{ t | topicSlug }}/"{% if page.url == "/topic/" + (t | topicSlug) + "/" %} aria-current="page"{% endif %}>{{ t }}</a></li>
                    {% endfor %}
                    <li><a href="/about/">About</a></li>
                    <li><a href="/feed.xml">RSS</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <main id="main" class="shell">
        {{ content | safe }}
    </main>
    <footer class="site-footer">
        <div class="shell footer-row">
            <a class="wordmark wordmark-small" href="/">Turning<span>Circle</span></a>
            <nav class="site-nav" aria-label="Footer navigation">
                {% for t in site.topics %}<a href="/topic/{{ t | topicSlug }}/">{{ t }}</a>{% endfor %}
                <a href="/archive/">Archive</a>
                <a href="/about/">About</a>
                <a href="/feed.xml">RSS</a>
            </nav>
        </div>
        <div class="shell footer-colophon">
            <p>&copy; 2026 TurningCircle. No cookies, no trackers. Set in Fraunces and Newsreader.</p>
        </div>
    </footer>
</body>
</html>
