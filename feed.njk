---json
{
  "permalink": "/feed.xml",
  "eleventyExcludeFromCollections": true
}
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/" rel="alternate"/>
  <updated>{% set newest = collections.posts | getNewestCollectionItemDate %}{{ newest | dateISO }}T00:00:00Z</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  {%- for post in collections.posts %}
  {%- set absolutePostUrl = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <updated>{{ post.date | dateISO }}T00:00:00Z</updated>
    <id>{{ absolutePostUrl }}</id>
    {% if post.data.description %}<summary>{{ post.data.description }}</summary>{% endif %}
    <content type="html">{{ post.templateContent | absoluteUrl(site.url) }}</content>
  </entry>
  {%- endfor %}
</feed>
